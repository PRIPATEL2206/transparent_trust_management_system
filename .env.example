# Trust Management System - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Django Core
# =============================================================================
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENV=development
# Options: development, production, test

# =============================================================================
# Database
# =============================================================================
# Development (SQLite - no config needed, auto-detected from DJANGO_ENV)
#
# Production (PostgreSQL):
DB_ENGINE=django.db.backends.postgresql
DB_NAME=trust_management
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Docker Compose uses:
# DB_HOST=postgres
# POSTGRES_PASSWORD=trustpass

# =============================================================================
# Redis (cache + channels + session)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
# Docker Compose uses: redis://redis:6379/0

# Cache backend (auto-configured per environment, override if needed)
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# Development default: django.core.cache.backends.locmem.LocMemCache

# =============================================================================
# Django Channels (WebSocket chat)
# =============================================================================
# Development:
CHANNEL_BACKEND=channels.layers.InMemoryChannelLayer
# Production:
# CHANNEL_BACKEND=channels_redis.core.RedisChannelLayer

# =============================================================================
# Timezone & Locale
# =============================================================================
TZ=UTC
LOG_LEVEL=INFO

# =============================================================================
# Email
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@domain.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# Security
# =============================================================================
SECURE_SSL_REDIRECT=False
SESSION_IDLE_TIMEOUT=1800
SESSION_MAX_AGE=86400
MAX_SESSIONS_PER_USER=3
HEALTH_CHECK_API_KEY=
PASSWORD_MAX_AGE_DAYS=90
THROTTLE_MAX_REQUESTS=100
THROTTLE_WINDOW=60

# CORS (only for /api/ endpoints)
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False

# =============================================================================
# Monitoring
# =============================================================================
# Sentry (leave empty to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production
APP_VERSION=1.0.0

# Prometheus metrics endpoint (leave empty for open access, set key for auth)
METRICS_API_KEY=

# Grafana (for docker-compose.monitoring.yml)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-in-production

# Audit logging (logs/audit.log - always enabled, rotates at 50MB x 10 backups)
LOG_LEVEL=INFO

# =============================================================================
# Docker / Deployment
# =============================================================================
POSTGRES_PASSWORD=trustpass

# Run commands:
#   Development: python manage.py runserver
#   Production:  docker compose up -d
#   Migrations:  python manage.py wait_for_db && python manage.py migrate
#   Static:      python manage.py collectstatic --noinput
#   Setup:       python manage.py setup_project --create-admin
#   Health:      GET /health/live/ (liveness) | GET /health/ready/ (readiness)
#   Smoke test:  bash scripts/smoke-test.sh https://yourdomain.com
#   Load test:   make loadtest-headless
